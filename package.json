{
  "name": "opspilot",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "homepage": "https://lucasmezen972-ui.github.io/opspilot",
  "private": true,
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 expo start",
    "build:web": "EXPO_NO_TELEMETRY=1 expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --config .eslintrc.json",
    "fix": "eslint . --ext .ts,.tsx --config .eslintrc.json --fix",
    "test": "vitest --run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@lucide/lab": "^0.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.55.0",
    "exceljs": "^4.4.0",
    "expo": "^53.0.0",
    "expo-blur": "~14.1.3",
    "expo-camera": "~16.1.5",
    "expo-constants": "~17.1.3",
    "expo-crypto": "^14.1.5",
    "expo-device": "^7.1.4",
    "expo-font": "~13.2.2",
    "expo-haptics": "~14.1.3",
    "expo-linear-gradient": "~14.1.3",
    "expo-linking": "~7.1.3",
    "expo-location": "^18.1.6",
    "expo-notifications": "^0.31.4",
    "expo-router": "~5.0.2",
    "expo-secure-store": "^14.2.3",
    "expo-splash-screen": "~0.30.6",
    "expo-status-bar": "~2.2.2",
    "expo-symbols": "~0.4.3",
    "expo-system-ui": "~5.0.5",
    "expo-web-browser": "~14.1.5",
    "lucide-react-native": "^0.475.0",
    "openai": "^5.20.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.1",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.3.0",
