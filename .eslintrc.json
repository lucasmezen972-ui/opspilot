{
  "extends": ["universe/native", "universe/shared/typescript-analysis"],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "project": "./tsconfig.json"
  },
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "warn",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ]
  },
  "overrides": [
    {
      "files": ["admin/**/*.js"],
      "env": { "browser": true }
    },
    {
      "files": ["public/sw.js"],
      "env": { "serviceworker": true }
    }
  ],
  "ignorePatterns": [
    "supabase/functions/**",
    "node_modules/**",
    "dist/**",
    "e2e/**",
    "playwright.config.ts"
  ]
}
