{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "app",
    "src",
    "components",
    "hooks",
    "lib",
    "test",
    "__tests__",
    "server",
    "global.d.ts",
    "vitest.config.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
