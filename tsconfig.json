{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "ignoreDeprecations": "5.0",
    "noEmit": true
  },
  "include": [
    "app",
    "components",
    "features",
    "hooks",
    "lib",
    "shared",
    "utils",
    "test",
    "__tests__",
    "global.d.ts",
    "vitest.config.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
